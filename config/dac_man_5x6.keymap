macros {
        to_mac_base: to_mac_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MAC_BASE>, <&kp F19>;
        };

        to_mac_l1: to_mac_l1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MAC_L1>, <&kp F20>;
        };

        to_win_base: to_win_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN_BASE>, <&kp F21>;
        };

        to_win_l1: to_win_l1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN_L1>, <&kp F22>;
        };

        f23_mac_layer: f23_mac_layer {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>, <&mo BLUE_MAC>,
                <&macro_tap>, <&kp F23>,
                <&macro_pause_for_release>,
                <&macro_release>, <&mo BLUE_MAC>;
        };

        f23_win_layer: f23_win_layer {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>, <&mo BLUE_WIN>,
                <&macro_tap>, <&kp F23>,
                <&macro_pause_for_release>,
                <&macro_release>, <&mo BLUE_WIN>;
        };
    };
