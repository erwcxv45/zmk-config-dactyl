#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MAC_BASE  0
#define MAC_L1    1
#define BLUE_MAC  2
#define WIN_BASE  3
#define WIN_L1    4
#define BLUE_WIN  5
#define MAC_ZONES 6
#define WIN_ZONES 7
#define F_KEYS    8

// Создаем сокращение для Hyper-ключа (Shift + Ctrl + Alt + Gui)
#define HYP(key) LS(LC(LA(LG(key))))

/ {
    macros {
        to_mac_base: to_mac_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MAC_BASE>, <&kp F19>;
        };

        to_mac_l1: to_mac_l1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MAC_L1>, <&kp F20>;
        };

        to_win_base: to_win_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN_BASE>, <&kp F21>;
        };

        to_win_l1: to_win_l1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN_L1>, <&kp F22>;
        };

        f23_mac_layer: f23_mac_layer {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>, <&mo BLUE_MAC>, <&kp F23>,
                <&macro_pause_for_release>,
                <&macro_release>, <&mo BLUE_MAC>, <&kp F23>;
        };

        f23_win_layer: f23_win_layer {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>, <&mo BLUE_WIN>, <&kp F23>,
                <&macro_pause_for_release>,
                <&macro_release>, <&mo BLUE_WIN>, <&kp F23>;
        };
    };

    behaviors {
        // Кастомное поведение для клавиши Globe
        // flavor = "tap-preferred" гарантирует выполнение тапа при отпускании до 175 мс
        ht_globe: hold_tap_globe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        ht_tog: hold_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            require-prior-idle-ms = <350>;
            bindings = <&tog>, <&kp>;
        };

        ht_kp: hold_tap_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            require-prior-idle-ms = <350>;
            bindings = <&kp>, <&kp>;
        };

        lt_kp: layer_tap_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            require-prior-idle-ms = <350>;
            bindings = <&mo>, <&kp>;
        };

        lt_long: layer_tap_long {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            require-prior-idle-ms = <350>;
            bindings = <&mo>, <&kp>;
        };

        ht_f_mac: ht_f_mac {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            require-prior-idle-ms = <350>;
            bindings = <&f23_mac_layer>, <&kp>;
        };

        ht_f_win: ht_f_win {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            require-prior-idle-ms = <350>;
            bindings = <&f23_win_layer>, <&kp>;
        };

        ht_l1_kp: hold_tap_l1_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        ht_l1_mkp: hold_tap_l1_mkp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&mkp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ================= MAC OS LAYERS =================

        mac_base {
            bindings = <
&none       &kp N1              &kp N2          &kp N3        &kp N4          &kp N5                                       &kp N6         &kp N7          &kp N8            &kp N9             &kp N0               &kp LGUI
&kp TAB     &kp Q               &kp W           &kp E         &kp R           &kp T                                        &kp Y          &kp U           &kp I             &kp O              &kp P                &kp LEFT_BRACKET
&to_mac_l1  &ht_tog BLUE_MAC A  &kp S           &kp D         &ht_f_mac 0 F   &kp G                                        &kp H          &ht_kp LCTRL J  &ht_kp INSERT K   &lt_kp MAC_ZONES L &ht_kp F3 SEMICOLON  &kp SQT
&ht_globe GLOBE HYP(SPACE) &kp Z &kp X        &kp C         &kp V           &kp B                                        &kp N          &kp M           &kp COMMA         &ht_kp END DOT     &kp LALT             &kp MINUS
                                &msc SCRL_DOWN  &msc SCRL_UP                                                                                              &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                                                              &kp LSHIFT                                                                                  &lt_long F_KEYS SLASH
                                                                              &kp LGUI  &none  &kp ESCAPE  &kp SPACE
                                                                              &none     &none  &kp RET     &kp BACKSPACE
            >;
        };

        mac_l1 {
            bindings = <
&none       &kp F5              &kp F8            &kp F9            &kp F10           &kp F12                                         &kp MINUS      &kp EQUAL               &kp SLASH               &kp ASTERISK            &kp EQUAL              &trans
&kp TAB     &ht_l1_mkp Q MB4    &ht_l1_mkp W MB1  &ht_l1_mkp E MB2  &ht_l1_mkp R MB3  &ht_l1_mkp T MB5                                &bt BT_SEL 0   &ht_l1_kp U NUMBER_7    &ht_l1_kp I NUMBER_8    &ht_l1_kp O NUMBER_9    &ht_l1_kp P EQUAL      &kp F11
&to_mac_base &ht_tog BLUE_MAC A &kp S             &kp D             &ht_f_mac 0 F     &ht_l1_kp G INSERT                              &bt BT_SEL 1   &ht_l1_kp LCTRL NUMBER_4 &ht_l1_kp INSERT NUMBER_5 &ht_l1_kp END NUMBER_6  &ht_l1_kp F3 NUMBER_0  &bt BT_CLR
&ht_globe GLOBE HYP(SPACE) &kp Z &kp X          &kp C             &kp V             &kp B                                           &bt BT_SEL 2   &ht_l1_kp M NUMBER_1    &ht_l1_kp COMMA NUMBER_2 &ht_l1_kp DOT NUMBER_3  &to_win_l1             &bt BT_CLR_ALL
                                &msc SCRL_DOWN    &msc SCRL_UP                                                                                                               &kp LEFT_BRACKET        &kp TILDE
                                                                    &trans                                                                                                   &kp SLASH
                                                                                      &trans              &trans  &kp ESC    &kp SPACE
                                                                                      &trans              &trans  &kp ENTER  &kp BACKSPACE
            >;
        };

        blue_mac {
            bindings = <
&none       &kp N1              &kp N2          &kp N3        &kp N4          &kp N5                                       &kp N6         &kp C_VOL_UP  &kp N8        &kp N9     &kp N0               &trans
&kp TAB     &kp Q               &kp W           &kp E         &kp R           &kp T                                        &kp Y          &kp C_VOL_DN  &kp UP_ARROW  &kp O      &kp P                &kp LEFT_BRACKET
&to_mac_l1  &ht_tog BLUE_MAC A  &kp S           &kp D         &ht_f_mac 0 F   &kp G                                        &kp H          &kp LEFT      &kp DOWN      &kp RIGHT  &ht_kp F3 SEMICOLON  &kp SQT
&ht_globe GLOBE HYP(SPACE) &kp Z &kp X          &kp C         &kp V           &kp B                                        &kp F16        &kp F13       &kp F14       &kp F15    &trans               &kp MINUS
                                &msc SCRL_DOWN  &msc SCRL_UP                                                                                            &kp F17       &kp F18
                                                              &trans                                                                                    &kp SLASH
                                                                              &trans    &none  &kp ESCAPE  &kp SPACE
                                                                              &trans    &none  &kp RET     &kp BACKSPACE
            >;
        };

        // ================= WINDOWS LAYERS =================

        win_base {
            bindings = <
&none         &kp N1              &kp N2          &kp N3        &kp N4          &kp N5                                         &kp N6         &kp N7          &kp N8            &kp N9             &kp N0               &kp LCTRL
&kp TAB       &kp Q               &kp W           &kp E         &kp R           &kp T                                          &kp Y          &kp U           &kp I             &kp O              &kp P                &kp LEFT_BRACKET
&to_win_l1    &ht_tog BLUE_WIN A  &kp S           &kp D         &ht_f_win 0 F   &kp G                                          &kp H          &ht_kp LCTRL J  &ht_kp INSERT K   &lt_kp WIN_ZONES L &ht_kp F3 SEMICOLON  &kp SQT
&kp LGUI      &kp Z               &kp X           &kp C         &kp V           &kp B                                          &kp N          &kp M           &kp COMMA         &ht_kp END DOT     &kp LALT             &kp MINUS
                                  &msc SCRL_DOWN  &msc SCRL_UP                                                                                                &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                                                                &kp LSHIFT                                                                                    &lt_long F_KEYS SLASH
                                                                                &kp LCTRL         &none  &kp ESCAPE  &kp SPACE
                                                                                &none             &none  &kp RET     &kp BACKSPACE
            >;
        };

        win_l1 {
            bindings = <
&none         &kp F5              &kp F8            &kp F9            &kp F10           &kp F12                                        &kp MINUS      &kp EQUAL               &kp SLASH               &kp ASTERISK            &kp EQUAL              &trans
&kp TAB       &ht_l1_mkp Q MB4    &ht_l1_mkp W MB1  &ht_l1_mkp E MB2  &ht_l1_mkp R MB3  &ht_l1_mkp T MB5                               &bt BT_SEL 0   &ht_l1_kp U NUMBER_7    &ht_l1_kp I NUMBER_8    &ht_l1_kp O NUMBER_9    &ht_l1_kp P EQUAL      &kp F11
&to_win_base  &ht_tog BLUE_WIN A  &kp S             &kp D             &ht_f_win 0 F     &ht_l1_kp G INSERT                             &bt BT_SEL 1   &ht_l1_kp LCTRL NUMBER_4 &ht_l1_kp INSERT NUMBER_5 &ht_l1_kp END NUMBER_6  &ht_l1_kp F3 NUMBER_0  &bt BT_CLR
&trans        &kp Z               &kp X             &kp C             &kp V             &kp B                                          &bt BT_SEL 2   &ht_l1_kp M NUMBER_1    &ht_l1_kp COMMA NUMBER_2 &ht_l1_kp DOT NUMBER_3  &to_mac_l1             &bt BT_CLR_ALL
                                  &msc SCRL_DOWN    &msc SCRL_UP                                                                                                              &kp LEFT_BRACKET        &kp TILDE
                                                                      &trans                                                                                                  &kp SLASH
                                                                                        &trans              &trans  &kp ESC    &kp SPACE
                                                                                        &trans              &trans  &kp ENTER  &kp BACKSPACE
            >;
        };

        blue_win {
            bindings = <
&none         &kp N1              &kp N2          &kp N3        &kp N4          &kp N5                                       &kp N6         &kp C_VOL_UP  &kp N8        &kp N9     &kp N0               &trans
&kp TAB       &kp Q               &kp W           &kp E         &kp R           &kp T                                        &kp Y          &kp C_VOL_DN  &kp UP_ARROW  &kp O      &kp P                &kp LEFT_BRACKET
&to_win_l1    &ht_tog BLUE_WIN A  &kp S           &kp D         &ht_f_win 0 F   &kp G                                        &kp H          &kp LEFT      &kp DOWN      &kp RIGHT  &ht_kp F3 SEMICOLON  &kp SQT
&trans        &kp Z               &kp X           &kp C         &kp V           &kp B                                        &kp F16        &kp F13       &kp F14       &kp F15    &trans               &kp MINUS
                                  &msc SCRL_DOWN  &msc SCRL_UP                                                                                            &kp F17       &kp F18
                                                                &trans                                                                                    &kp SLASH
                                                                                &trans    &none  &kp ESCAPE  &kp SPACE
                                                                                &trans    &none  &kp RET     &kp BACKSPACE
            >;
        };

        // ================= MONITOR ZONES =================

        mac_zones {
            bindings = <
&none   &kp HYP(N1) &kp HYP(N2) &kp HYP(N3) &kp HYP(N4) &kp HYP(N5)    &trans &trans &trans &trans &trans &trans
&trans  &kp HYP(Q)  &kp HYP(W)  &kp HYP(E)  &kp HYP(R)  &kp HYP(T)     &trans &trans &trans &trans &trans &trans
&trans  &kp HYP(A)  &kp HYP(S)  &kp HYP(D)  &kp HYP(F)  &kp HYP(G)     &trans &trans &trans &trans &trans &trans
&trans  &kp HYP(Z)  &kp HYP(X)  &kp HYP(C)  &kp HYP(V)  &kp HYP(B)     &trans &trans &trans &trans &trans &trans
                    &trans      &trans                                        &trans &trans
                                &trans                                 &trans
                                            &trans &trans &trans &trans
                                            &trans &trans &trans &trans
            >;
        };

        win_zones {
            bindings = <
&none   &kp HYP(N1) &kp HYP(N2) &kp HYP(N3) &kp HYP(N4) &kp HYP(N5)    &trans &trans &trans &trans &trans &trans
&trans  &kp HYP(Q)  &kp HYP(W)  &kp HYP(E)  &kp HYP(R)  &kp HYP(T)     &trans &trans &trans &trans &trans &trans
&trans  &kp HYP(A)  &kp HYP(S)  &kp HYP(D)  &kp HYP(F)  &kp HYP(G)     &trans &trans &trans &trans &trans &trans
&trans  &kp HYP(Z)  &kp HYP(X)  &kp HYP(C)  &kp HYP(V)  &kp HYP(B)     &trans &trans &trans &trans &trans &trans
                    &trans      &trans                                        &trans &trans
                                &trans                                 &trans
                                            &trans &trans &trans &trans
                                            &trans &trans &trans &trans
            >;
        };

        // ================= F KEYS =================

        f_keys {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10 &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans                                    &trans  &trans
                        &trans                            &trans
                                &trans  &trans  &trans  &trans
                                &trans  &trans  &trans  &trans
            >;
        };
    };
};
